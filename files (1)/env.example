# ================================
# ZeroTrust AI — Environment Variables
# Copy this to .env and fill in values
# ================================

# Gemini API (Free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash    # Free + fast, perfect for hackathon

# App Config
OFFLINE_MODE=false          # Set true if no internet during demo
MOCK_LLM=false              # Set true to skip real LLM calls
LLM_CONFIDENCE_MIN=0.4      # Only call LLM if ML confidence in this range
LLM_CONFIDENCE_MAX=0.8
LLM_TIMEOUT_SECONDS=3       # Fallback to mock if Gemini takes longer

# Database (MySQL)
# Install MySQL locally or use freemysqlhosting.net for free cloud MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=zerotrust_ai
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/zerotrust_ai

# Self-Healing Agent
SELFHEAL_TRIGGER_SEVERITY=HIGH   # Trigger on HIGH and CRITICAL incidents
SYSTEM_HEALTH_INITIAL=100.0
PACKETS_PER_SECOND=2
ATTACK_PROBABILITY=0.15     # 15% of packets are attacks

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
